# Copy to .env (never commit .env). Fill in the empty values.

# --- AWS / Bedrock (region ap-south-1, Mumbai) -----------------------------
AWS_REGION=ap-south-1
# Option A (simplest): a Bedrock API key
AWS_BEARER_TOKEN_BEDROCK=
# Option B: IAM user keys (leave empty if you use option A)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Model IDs (checked 2026-11-23, see docs/SPEC.md section 2.2)
BEDROCK_VISION_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_VISION_ESCALATION_MODEL_ID=apac.amazon.nova-pro-v1:0
BEDROCK_TEXT_MODEL_ID=global.amazon.nova-2-lite-v1:0

# --- Anthropic API (used only for the final test run, docs/SPEC.md decision 2)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-haiku-5-5

# --- LLM mode: fake (tests), replay (recorded answers, no network), live ----
LLM_MODE=replay

# --- Budgets and limits -----------------------------------------------------
RUN_BUDGET_USD=1.00
RUN_BUDGET_TOKENS=500000
RUN_BUDGET_SECONDS=900
LIVE_BUDGET_USD=5
ANTHROPIC_BUDGET_USD=3
ORCH_MAX_CONCURRENCY=2
LLM_REQUESTS_PER_SECOND=2

# --- Approval UI ------------------------------------------------------------
# Name recorded on each approval (defaults to the OS user name)
APPROVER_NAME=

# --- Storage ----------------------------------------------------------------
DATA_DIR=data
DB_PATH=data/orchestrator.sqlite

# --- Sibling projects (optional; in-repo stubs are used when empty) --------
# Path or git URL for each package, if you want the real ones instead of stubs.
GUARDRAILS_PACKAGE=
REGULATORY_RAG_PACKAGE=
SEMANTIC_CACHE_PACKAGE=
